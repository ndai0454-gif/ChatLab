@model List<ExchangeRate.Data.Models.ExchangeRateRecord>

@{
    ViewData["Title"] = "Tỷ giá mới nhất";
}

<h1>Tỷ giá mới nhất</h1>

<p>
    <a asp-action="Index" class="btn btn-sm btn-outline-primary">Danh sách</a>
    <a asp-action="Statistics" class="btn btn-sm btn-outline-primary">Thống kê trung bình</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Loại tiền</th>
            <th>Mua vào</th>
            <th>Bán ra</th>
            <th>Cập nhật lúc</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rate in Model)
        {
            <tr>
                <td>@rate.CurrencyCode/@rate.BaseCurrency</td>
                <td>@rate.BuyRate.ToString("N2")</td>
                <td>@rate.SellRate.ToString("N2")</td>
                <td>@rate.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Không có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>
