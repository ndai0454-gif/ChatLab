@page
@model IndexModel
@{
    ViewData["Title"] = "Danh sách tỷ giá";
    var isFiltered = Model.Date.HasValue || !string.IsNullOrWhiteSpace(Model.Currency);
}

<h1>Danh sách tỷ giá</h1>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="date">Ngày</label>
        <input type="date" id="date" name="date" class="form-control"
               value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="currency">Loại tiền</label>
        <select id="currency" name="currency" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var c in Model.AvailableCurrencies)
            {
                <option value="@c" selected="@(c == Model.Currency)">@c</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a asp-page="/Index" class="btn btn-outline-secondary">Xoá bộ lọc</a>
    </div>
</form>

@if (!isFiltered)
{
    <p class="text-muted small">Dữ liệu mới sẽ tự động xuất hiện ở đầu bảng (real-time).</p>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Thời gian</th>
            <th>Loại tiền</th>
            <th>Mua vào</th>
            <th>Bán ra</th>
        </tr>
    </thead>
    <tbody id="rates-body">
        @foreach (var rate in Model.Rates)
        {
            <tr>
                <td>@rate.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@rate.CurrencyCode/@rate.BaseCurrency</td>
                <td>@rate.BuyRate.ToString("N2")</td>
                <td>@rate.SellRate.ToString("N2")</td>
            </tr>
        }
        @if (!Model.Rates.Any())
        {
            <tr id="empty-row">
                <td colspan="4" class="text-center text-muted">Không có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @if (!isFiltered)
    {
        <script>
            // Only the unfiltered list is live: prepend each pushed batch and keep the table at 200 rows.
            window.rateHub.onRates(rates => {
                const body = document.getElementById("rates-body");
                document.getElementById("empty-row")?.remove();
                for (const r of rates.slice().reverse()) {
                    const tr = document.createElement("tr");
                    tr.className = "table-info";
                    [window.rateHub.fmtTime(r.timestamp), r.currencyCode + "/" + r.baseCurrency,
                     window.rateHub.fmt(r.buyRate), window.rateHub.fmt(r.sellRate)]
                        .forEach(text => { const td = document.createElement("td"); td.textContent = text; tr.appendChild(td); });
                    body.prepend(tr);
                    setTimeout(() => tr.classList.remove("table-info"), 1500);
                }
                while (body.rows.length > 200) body.deleteRow(-1);
            });
        </script>
    }
}
