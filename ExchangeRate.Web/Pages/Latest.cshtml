@page
@model LatestModel
@{
    ViewData["Title"] = "Tỷ giá mới nhất";
}

<h1>Tỷ giá mới nhất</h1>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Loại tiền</th>
            <th>Mua vào</th>
            <th>Bán ra</th>
            <th>Cập nhật lúc</th>
        </tr>
    </thead>
    <tbody id="latest-body">
        @foreach (var rate in Model.Rates)
        {
            <tr data-currency="@rate.CurrencyCode">
                <td>@rate.CurrencyCode/@rate.BaseCurrency</td>
                <td class="buy">@rate.BuyRate.ToString("N2")</td>
                <td class="sell">@rate.SellRate.ToString("N2")</td>
                <td class="time">@rate.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // Update (or add) one row per currency whenever the server pushes a new batch.
        window.rateHub.onRates(rates => {
            const body = document.getElementById("latest-body");
            for (const r of rates) {
                let tr = body.querySelector(`tr[data-currency="${r.currencyCode}"]`);
                if (!tr) {
                    tr = document.createElement("tr");
                    tr.dataset.currency = r.currencyCode;
                    tr.innerHTML = "<td></td><td class='buy'></td><td class='sell'></td><td class='time'></td>";
                    body.appendChild(tr);
                }
                tr.cells[0].textContent = r.currencyCode + "/" + r.baseCurrency;
                tr.querySelector(".buy").textContent = window.rateHub.fmt(r.buyRate);
                tr.querySelector(".sell").textContent = window.rateHub.fmt(r.sellRate);
                tr.querySelector(".time").textContent = window.rateHub.fmtTime(r.timestamp);
                tr.classList.add("table-warning");
                setTimeout(() => tr.classList.remove("table-warning"), 1000);
            }
        });
    </script>
}
