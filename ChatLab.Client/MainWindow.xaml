<Window x:Class="ChatLab.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatLab" Height="720" Width="980" MinWidth="720" MinHeight="520"
        FontFamily="Segoe UI, Segoe UI Emoji" FontSize="14" Background="#ECE5DD"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- connection bar -->
        <Border Grid.Row="0" Background="#075E54" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💬 ChatLab" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="Server" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="HostBox" Text="127.0.0.1:9000" Width="140" VerticalContentAlignment="Center" />
                <TextBlock Text="Name" Foreground="White" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="NameBox" Width="140" VerticalContentAlignment="Center" />
                <Button x:Name="ConnectButton" Content="Connect" Margin="12,0,0,0" Padding="16,3" Click="Connect_Click" />
                <TextBlock x:Name="StateText" Foreground="#CDEBE7" VerticalAlignment="Center" Margin="12,0,0,0" Text="Disconnected" />
            </StackPanel>
        </Border>

        <!-- messages + online users -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="MessageList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="8,3" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="{Binding Align}" Background="{Binding BubbleBrush}"
                                CornerRadius="10" Padding="10,6" MaxWidth="460">
                            <StackPanel>
                                <!-- system notice -->
                                <TextBlock Text="{Binding Text}" Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"
                                           Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding Sender}" Foreground="{Binding SenderBrush}" FontWeight="Bold"
                                           Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}" />

                                <!-- plain text (emoji render in colour through the Segoe UI Emoji fallback) -->
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"
                                           Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />

                                <!-- image / file card -->
                                <StackPanel Visibility="{Binding IsAttachment, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                                           Cursor="Hand" MouseLeftButtonUp="Image_Click"
                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ImageNote}" Foreground="Gray" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="📎" FontSize="20" VerticalAlignment="Center" />
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                            <TextBlock Text="{Binding SizeText}" Foreground="Gray" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Open" Padding="10,2" Margin="0,0,6,0" Click="Open_Click"
                                                Visibility="{Binding HasLocal, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Save as..." Padding="10,2" Click="SaveAs_Click" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding TimeText}" Foreground="Gray" FontSize="10" HorizontalAlignment="Right"
                                           Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding TimeText}" Foreground="Gray" FontSize="10" HorizontalAlignment="Right"
                                           Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Background="White" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🟢 Online" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox x:Name="UserList" BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- running transfers: one bar per parallel stream -->
        <ItemsControl x:Name="TransferList" Grid.Row="2" Background="#F7F7F7">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="12" />
                            <ProgressBar Height="10" Maximum="100" Value="{Binding Percent}" Margin="0,3,0,3" />
                            <ItemsControl ItemsSource="{Binding Streams}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="Gray" />
                                            <ProgressBar Height="6" Maximum="{Binding Maximum}" Value="{Binding Done}" Foreground="#25D366" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- attachment preview before sending -->
        <Border x:Name="AttachPanel" Grid.Row="3" Background="White" Padding="10" Visibility="Collapsed"
                BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✖" Width="28" Height="28" Click="RemoveAttachment_Click" VerticalAlignment="Top" />
                <Image x:Name="AttachImage" DockPanel.Dock="Left" MaxHeight="120" MaxWidth="160" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AttachName" FontWeight="SemiBold" />
                    <TextBlock x:Name="AttachSize" Foreground="Gray" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- input row -->
        <Grid Grid.Row="4" Background="#F0F0F0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="EmojiButton" Grid.Column="0" Content="😀" FontSize="22" Width="44" Margin="8,8,0,8" Click="Emoji_Click" />
            <Button x:Name="AttachButton" Grid.Column="1" Content="📎" FontSize="22" Width="44" Margin="6,8,0,8" Click="Attach_Click" ToolTip="Attach an image or any file (500 MB+ supported)" />
            <TextBox x:Name="InputBox" Grid.Column="2" Margin="6,8" FontSize="16" VerticalContentAlignment="Center"
                     AcceptsReturn="False" KeyDown="InputBox_KeyDown" />
            <Button x:Name="SendButton" Grid.Column="3" Content="Send ➤" Margin="0,8,8,8" Padding="18,0" Click="Send_Click" />
        </Grid>

        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" />
    </Grid>
</Window>
